<style type="text/css">
.pl-mailbox { color: #1d2935; contain: inline-size; font-family: Arial, Helvetica, sans-serif; margin: 0; min-width: 0; overflow-wrap: anywhere; }
.pl-mailbox a { color: #174e80; }
.pl-mailbox-nav { align-items: center; border-bottom: 1px solid #b6c5d2; display: flex; flex-wrap: wrap; font-size: .86rem; gap: .5rem 1.2rem; padding: .45rem 0 .65rem; }
.pl-mailbox-nav .pl-mailbox-compose { margin-left: auto; font-weight: bold; }
.pl-mailbox-summary { color: #526170; font-size: .82rem; margin: .8rem 0; }
.pl-mailbox-pager { font-size: .85rem; padding: .6rem 0; text-align: center; }
.pl-mailbox-list { list-style: none; margin: 0; padding: 0; }
.pl-mailbox-row { align-items: baseline; border-bottom: 1px solid #cbd6de; display: grid; font-size: .86rem; gap: .5rem 1rem; grid-template-columns: minmax(0, 1fr) minmax(0, 12rem) 6rem; padding: .65rem .2rem; }
.pl-mailbox-row-sent { grid-template-columns: minmax(0, 1fr) minmax(0, 12rem) 6rem 4rem; }
.pl-mailbox-row:first-child { border-top: 1px solid #cbd6de; }
.pl-mailbox-row:hover { background: #f5f8fa; }
.pl-mailbox-subject { font-weight: bold; }
.pl-mailbox-row > * { min-width: 0; }
.pl-mailbox-date { color: #526170; font-size: .8rem; font-variant-numeric: tabular-nums; text-align: right; }
.pl-mailbox-read { color: #526170; font-size: .8rem; text-align: right; }
.pl-mailbox-empty { border-top: 1px solid #cbd6de; color: #526170; padding: 1rem 0; }
.pl-mailbox-form { max-width: 48rem; padding: .75rem .5rem; }
.pl-mailbox-field { margin-bottom: .85rem; min-width: 0; }
.pl-mailbox-field label { display: block; font-size: .85rem; font-weight: bold; margin-bottom: .25rem; }
.pl-mailbox-field input, .pl-mailbox-field textarea { background: #fff; border: 1px solid #9aaab9; box-sizing: border-box; color: #1d2935; font: normal .95rem Arial, Helvetica, sans-serif; max-width: 100%; padding: .4rem .5rem; width: 100%; }
.pl-mailbox-field textarea { line-height: 1.5; min-height: 12rem; resize: vertical; }
.pl-mailbox-actions { display: flex; flex-wrap: wrap; gap: .5rem .75rem; margin: .5rem 0; }
.pl-mailbox-actions button { background: #194f78; border: 1px solid #153f60; color: #fff; cursor: pointer; font: normal .85rem Arial, Helvetica, sans-serif; min-height: 1.85rem; padding: .25rem .7rem; }
.pl-mailbox-actions button.secondary { background: #f0f4f7; color: #174e80; }
.pl-mailbox-error { background: #fff4f1; border-left: 3px solid #a12d23; color: #84231d; font-size: .9rem; margin-bottom: .85rem; padding: .5rem .75rem; }
.pl-mailbox-spell { border-bottom: 1px solid #cbd6de; margin-bottom: .85rem; overflow-x: auto; padding-bottom: .75rem; }
.pl-mailbox-message { padding: .75rem .5rem; }
.pl-mailbox-details { display: flex; flex-wrap: wrap; gap: .75rem 2rem; margin: 0 0 1rem; }
.pl-mailbox-details div { min-width: 0; }
.pl-mailbox-details dt { color: #526170; font-size: .8rem; }
.pl-mailbox-details dd { font-size: .9rem; margin: 0; }
.pl-mailbox-message h2, .pl-mailbox-original h2 { font-size: 1rem; margin: .5rem 0; }
.pl-mailbox-text { background: #f0f4f7; border-top: 1px solid #cbd6de; font-size: .95rem; line-height: 1.5; margin: .5rem 0 1rem; padding: .75rem; white-space: pre-wrap; }
.pl-mailbox-original { border-top: 1px solid #cbd6de; margin-top: 1rem; padding-top: .5rem; }
.pl-mailbox :focus-visible { outline: 2px solid #003399; outline-offset: 2px; }
@media (max-width: 600px) {
  .pl-mailbox-row, .pl-mailbox-row-sent { grid-template-columns: minmax(0, 1fr) 6rem; gap: .35rem .75rem; }
  .pl-mailbox-subject { grid-column: 1 / -1; }
  .pl-mailbox-read { grid-column: 1 / -1; text-align: left; }
}
</style>
