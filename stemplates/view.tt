<html>
  <head>
    <title>[% title | html %][% IF site_name && title != site_name %] | [% site_name | html %][% END %]</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    [% IF native_search %]
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <style>
      .pl-native-search-shell .pl-search-layout { table-layout: fixed; }
      @media (max-width: 560px) {
        .pl-native-search-shell > table:first-of-type tr { display: flex; flex-wrap: wrap; }
        .pl-native-search-shell > table:first-of-type td { box-sizing: border-box; max-width: 100%; }
        .pl-native-search-shell > table:first-of-type img { max-width: 100%; height: auto; }
        .pl-native-search-shell > table:first-of-type td:last-child { width: 100%; text-align: left; }
        .pl-native-search-shell #cse-search-box .pl-header-search-controls { justify-content: flex-start; }
        .pl-native-search-shell #pl-header-search-q { flex: 1; width: 100%; }
        .pl-native-search-shell .pl-search-layout, .pl-native-search-shell .pl-search-layout > tbody { display: block; }
        .pl-native-search-shell .pl-search-layout > tbody > tr { display: flex; flex-direction: column-reverse; }
        .pl-native-search-shell .pl-search-layout > tbody > tr > td { display: block; width: auto; padding: 0 !important; }
        .pl-native-search-shell .pl-search-layout > tbody > tr > td:first-child { margin-top: 1rem; }
      }
    </style>
    [% END %]

    [% IF canonical_url %]
      <link rel="canonical" href="[% canonical_url | html %]" />
      [% IF article_description %]
      <meta name="description" content="[% article_description | html %]" />
      [% END %]
    [% END %]
    
    [% IF no_index %]
      <meta name="robots" content="noindex,follow" />
    [% END %]

    <!-- favicon -->
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon"/>
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon"/>

  </head>
  <body[% IF native_search %] class="pl-native-search-shell"[% END %]>
    [% header %]

    <!-- content and sidebar -->
    <table[% IF native_search %] class="pl-search-layout"[% END %] WIDTH="100%" CELLPADDING="0" CELLSPACING="0" style="border-collapse:collapse;">
        <tr>
            <td WIDTH="155" VALIGN="TOP" ALIGN="LEFT" style="padding:0 12px 0 0;">
                [% sidebar %]
            </td>
            <td VALIGN="TOP" ALIGN="LEFT" style="padding:0;">
                [% content %]
            </td>
        </tr>
    </table>
  </body>
</html>
