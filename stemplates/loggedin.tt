<section class="pl-sidebar-section" aria-label="Your account">
  <h2 class="pl-sidebar-title">[% username | html %]</h2>
  <div class="pl-sidebar-body">
    <a class="pl-sidebar-logout" href="/?op=logout">Logout</a>
    <nav aria-label="Account navigation">
      <h3>Your stuff</h3>
      <a href="/?op=settings">My Settings</a>
      <a href="/?op=collab">Collaborations</a>
      <a href="/?op=edituserobjs">My Articles</a>
      <a href="/?op=editcors">Corrections <span class="pl-sidebar-count">([% corrections | html %])</span></a>
      <a href="/?op=mailbox">Mailbox <span class="pl-sidebar-count">([% mail | html %])</span></a>
      <a href="/?op=notices">Notices <span class="pl-sidebar-count">([% notices | html %])</span></a>
      <h3>Members only</h3>
      <a href="/?op=useractivity">User activity</a>
      <a href="/?op=userlist">User list</a>
      <a href="/?op=sysstats">Sys stats</a>
      <h3>Add to the library</h3>
      <a href="/?op=adden">Create Article</a>
      <a href="/?op=addobj;to=papers">Add a Paper</a>
      <a href="/?op=addobj;to=books">Add a Book</a>
      <a href="/?op=addobj;to=lec">Add a Lecture</a>
      [% IF editor %]
      <h3>Editor tools</h3>
      <a href="/?op=unpublished">Unpublished</a>
      <a href="/?op=deleted">Deleted</a>
      [% END %]
    </nav>
  </div>
</section>

        
            
    


