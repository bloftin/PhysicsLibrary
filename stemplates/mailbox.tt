[% DEFAULT folder = 'mailbox' %]
[% INCLUDE mailstyles.tt %]
<div class="pl-mailbox">
  [% INCLUDE modernboxheader.tt title = title %]
  [% INCLUDE mailnav.tt %]
  <p class="pl-mailbox-summary">[% count | html %] [% IF folder == 'sentmail' %]sent[% ELSIF folder == 'oldmail' %]old[% ELSE %]unread[% END %] message[% IF count != 1 %]s[% END %]</p>
  [% IF rows.size %]
  [% IF pager %]<nav class="pl-mailbox-pager" aria-label="Mail pages">[% pager %]</nav>[% END %]
  <ul class="pl-mailbox-list" aria-label="[% IF folder == 'sentmail' %]Sent[% ELSIF folder == 'oldmail' %]Old[% ELSE %]Unread[% END %] messages">
    [% FOREACH row IN rows %]
    <li class="pl-mailbox-row[% IF folder == 'sentmail' %] pl-mailbox-row-sent[% END %]">
      <a class="pl-mailbox-subject" href="[% main_url | html %]/?op=getmail&amp;id=[% row.uid | html %]">[% IF row.subject.length %][% row.subject | html %][% ELSE %](No subject)[% END %]</a>
      <span class="pl-mailbox-participant">[% IF folder == 'sentmail' %]To[% ELSE %]From[% END %] <a class="pl-mailbox-sender" href="[% main_url | html %]/?op=getuser&amp;id=[% IF folder == 'sentmail' %][% row.userto | html %][% ELSE %][% row.userfrom | html %][% END %]">[% row.username | html %]</a></span>
      <span class="pl-mailbox-date">[% row.date | html %]</span>
      [% IF folder == 'sentmail' %]<span class="pl-mailbox-read">[% row.read_label | html %]</span>[% END %]
    </li>
    [% END %]
  </ul>
  [% IF pager %]<nav class="pl-mailbox-pager" aria-label="Mail pages">[% pager %]</nav>[% END %]
  [% ELSE %]<p class="pl-mailbox-empty">[% IF folder == 'sentmail' %]No sent mail.[% ELSIF folder == 'oldmail' %]No old mail.[% ELSE %]No new mail.[% END %]</p>[% END %]
</div>
