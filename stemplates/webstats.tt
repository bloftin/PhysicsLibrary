<style type="text/css">
.pl-webstats { color: #1d2935; font-family: Arial, Helvetica, sans-serif; min-width: 0; }
.pl-webstats-toolbar { align-items: center; background: #f0f4f7; border: 1px solid #cbd6de; display: flex; flex-wrap: wrap; font-size: .85rem; gap: .5rem 1rem; justify-content: space-between; margin: 0 0 .65rem; padding: .45rem .65rem; }
.pl-webstats-toolbar span { color: #445b70; }
.pl-webstats-toolbar a { color: #064d93; overflow-wrap: anywhere; }
.pl-webstats-toolbar a:focus-visible { outline: 2px solid #003399; outline-offset: 2px; }
.pl-webstats-report { background: #fff; border: 1px solid #cbd6de; box-sizing: border-box; display: block; height: clamp(32rem, calc(100vh - 12rem), 60rem); width: 100%; }
@media (max-width: 640px) {
  .pl-webstats-report { height: 75vh; min-height: 24rem; }
}
</style>

<section class="pl-webstats" aria-label="Web Statistics">
  [% INCLUDE modernboxheader.tt title = 'Web Statistics' %]
  <div class="pl-webstats-toolbar">
    <span>AWStats</span>
    <a href="[% stats_url | html %]" target="_blank" rel="noopener" title="Opens in a new tab">Open web stats in a separate page</a>
  </div>
  <iframe class="pl-webstats-report" src="[% stats_url | html %]" title="PhysicsLibrary web stats"></iframe>
</section>
