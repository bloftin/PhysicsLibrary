<style type="text/css">
.pl-polls { color: #1d2935; font-family: Arial, Helvetica, sans-serif; margin: 0 auto; max-width: 76rem; }
.pl-polls a { color: #064d93; }
.pl-polls-summary { color: #526170; font-size: .88rem; margin: 0 0 1.25rem; }
.pl-polls-section { margin: 1.15rem 0 1.6rem; }
.pl-polls-section h2 { color: #17212b; font-size: 1.08rem; margin: 0 0 .45rem; }
.pl-polls-count { color: #526170; font-size: .84rem; margin: 0 0 .7rem; }
.pl-polls-list { border-top: 1px solid #b6c5d2; }
.pl-polls-row { border-bottom: 1px solid #cbd6de; padding: .75rem .15rem; }
.pl-polls-row h3 { font-size: 1.02rem; line-height: 1.35; margin: 0; }
.pl-polls-row h3 a { color: #17212b; }
.pl-polls-row h3 a:hover, .pl-polls-row h3 a:focus { color: #064d93; }
.pl-polls-dates { color: #586673; font-size: .82rem; margin: .25rem 0 0; }
.pl-polls-actions { display: flex; flex-wrap: wrap; font-size: .85rem; gap: .45rem .9rem; margin-top: .55rem; }
.pl-polls-vote { background: #174e80; border: 1px solid #103a61; color: #fff !important; display: inline-block; font-weight: bold; padding: .3rem .6rem; text-decoration: none; }
.pl-polls-vote:hover, .pl-polls-vote:focus { background: #103a61; }
.pl-polls-results { align-self: center; }
.pl-polls-empty { border: 1px solid #b6c5d2; color: #526170; font-size: .86rem; margin: 0; padding: .75rem; }
</style>

<div class="pl-polls">
  [% INCLUDE modernboxheader.tt title = 'Polls' %]
  <p class="pl-polls-summary">Vote in current polls and browse results from earlier ones.</p>

  <section class="pl-polls-section" aria-labelledby="open-polls-heading">
    <h2 id="open-polls-heading">Open Polls</h2>
    [% IF open_polls.size %]
      <p class="pl-polls-count">[% open_polls.size %] poll[% IF open_polls.size != 1 %]s[% END %] accepting votes.</p>
      <div class="pl-polls-list">
        [% FOREACH poll IN open_polls %]
          <article class="pl-polls-row">
            <h3><a href="[% poll.results_url %]">[% poll.title %]</a></h3>
            <p class="pl-polls-dates">[% poll.start %] to [% poll.finish %]</p>
            <div class="pl-polls-actions"><a class="pl-polls-vote" href="[% poll.vote_url %]">Vote</a><a class="pl-polls-results" href="[% poll.results_url %]">View results</a></div>
          </article>
        [% END %]
      </div>
    [% ELSE %]
      <p class="pl-polls-empty">[% IF closed_polls.size %]No polls are open right now.[% ELSE %]No polls have been posted yet.[% END %]</p>
    [% END %]
  </section>

  [% IF closed_polls.size %]
    <section class="pl-polls-section" aria-labelledby="past-polls-heading">
      <h2 id="past-polls-heading">Past Polls</h2>
      <p class="pl-polls-count">[% closed_polls.size %] completed poll[% IF closed_polls.size != 1 %]s[% END %].</p>
      <div class="pl-polls-list">
        [% FOREACH poll IN closed_polls %]
          <article class="pl-polls-row">
            <h3><a href="[% poll.results_url %]">[% poll.title %]</a></h3>
            <p class="pl-polls-dates">[% poll.start %] to [% poll.finish %]</p>
            <div class="pl-polls-actions"><a href="[% poll.results_url %]">View results</a></div>
          </article>
        [% END %]
      </div>
    </section>
  [% END %]
</div>
