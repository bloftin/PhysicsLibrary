<section class="pl-sidebar-section" aria-label="Sign in">
  <h2 class="pl-sidebar-title">Login</h2>
  <div class="pl-sidebar-body">
    [% IF Error %]<p class="pl-sidebar-error" role="alert">[% Error | html %]</p>[% END %]
    <form method="post" action="/" class="pl-sidebar-login">
      <label for="pl-login-user">Username</label>
      <input id="pl-login-user" type="text" name="user" maxlength="48" autocomplete="username">
      <label for="pl-login-password">Password</label>
      <input id="pl-login-password" type="password" name="passwd" maxlength="32" autocomplete="current-password">
      <input type="hidden" name="url" value="/">
      <input type="hidden" name="op" value="login">
      <button type="submit">Login</button>
    </form>
    <a href="/?op=newuser">Create new user</a>
    <a href="/?op=pwchangereq">Forgot your password?</a>
  </div>
</section>
