<div id="login">
        <form METHOD="post" ACTION="/">
            <!-- standard box -->
            <table width="100%">
                <tr>
                    <td bgcolor="#000000" style="white-space:nowrap;">
                        <table WIDTH="100%" BORDER="0" CELLPADDING="4" CELLSPACING="0">

                            <!-- title -->
                            <tr>
                                <td WIDTH="100%" BGCOLOR="#003399">
                                    <font color="white" class="box_title">
                                       Login
                                    </font>
                                </td>
                            </tr>
                        
                            <!-- content -->
                            <tr>
                                <td BGCOLOR="dddddd" style="white-space:nowrap;">
                                    <table width="100%" border="0" cellpadding="4" cellspacing="0">
                                        <tr> 
                                            <small>
                                                <a HREF="/?op=newuser">create new user</a>
                                            </small>
                                        </tr>  

                                        <tr>
                                            <td ALIGN="CENTER" COLSPAN="2"><font COLOR="#FF0000" SIZE="+1">[% Error %]</font>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td ALIGN="RIGHT">
                                                <small>
                                                    Username:
                                                </small>
                                            </td>
                                            <td>
                                                <input class="small" TYPE="text" NAME="user" SIZE="8" MAXLENGTH="48"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td ALIGN="RIGHT">
                                                <small>
                                                    Password:
                                                </small>
                                            </td>
                                            <td>
                                                <input class="small" TYPE="password" NAME="passwd" SIZE="8" MAXLENGTH="32"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td COLSPAN="2" ALIGN="CENTER">
                                                <input TYPE="hidden" NAME="url" VALUE="/"/>
                                                <input TYPE="hidden" NAME="op" VALUE="login"/>
                                                <input class="small" TYPE="submit" VALUE="login"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="center" colspan="2"><font size="-2"><a href="/?op=pwchangereq">forget your password?</a></font>
                                            </td>
                                        </tr>
                                            
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <!-- end standard box -->
                
        </form>
</div>
