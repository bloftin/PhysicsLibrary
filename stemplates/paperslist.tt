<style type="text/css">
.pl-papers-list { color: #1d2935; font-family: Arial, Helvetica, sans-serif; margin: 0 auto; max-width: 76rem; }
.pl-papers-list a { color: #064d93; }
.pl-papers-list-header { margin: 0 0 1rem; }
.pl-papers-list-header-row { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
.pl-papers-list-summary { color: #526170; font-size: .88rem; margin: .4rem 0 0; }
.pl-papers-list-create { background: #174e80; border: 1px solid #103a61; color: #fff !important; font-size: .86rem; font-weight: bold; padding: .35rem .65rem; text-decoration: none; white-space: nowrap; }
.pl-papers-list-create:hover, .pl-papers-list-create:focus { background: #103a61; }
.pl-papers-list-nav { border-bottom: 1px solid #b6c5d2; display: flex; flex-wrap: wrap; font-size: .87rem; gap: .35rem .9rem; margin: 0 0 1rem; padding: 0 0 .6rem; }
.pl-papers-list-nav a[aria-current="page"] { color: #17212b; font-weight: bold; text-decoration: none; }
.pl-papers-list-toolbar { background: #eef3f7; border: 1px solid #b6c5d2; margin: 0 0 1rem; padding: .75rem; }
.pl-papers-list-toolbar-grid { align-items: end; display: grid; gap: .7rem; grid-template-columns: minmax(12rem, 1fr) minmax(8rem, .42fr) minmax(8rem, .42fr) auto; }
.pl-papers-list label { color: #314353; display: block; font-size: .79rem; font-weight: bold; margin-bottom: .22rem; }
.pl-papers-list input[type="search"], .pl-papers-list select { box-sizing: border-box; font-size: .92rem; min-height: 2rem; padding: .25rem .38rem; width: 100%; }
.pl-papers-list-button { background: #174e80; border: 1px solid #103a61; color: #fff; cursor: pointer; font-size: .86rem; min-height: 2rem; padding: .3rem .7rem; }
.pl-papers-list-tools { font-size: .84rem; margin: .65rem 0 0; }
.pl-papers-list-pager { border-bottom: 1px solid #b6c5d2; font-size: .9rem; margin: 0 0 .55rem; padding: 0 0 .45rem; text-align: center; }
.pl-papers-list-results + .pl-papers-list-pager { border-bottom: 0; border-top: 1px solid #b6c5d2; margin: .55rem 0 0; padding: .55rem 0 0; }
.pl-papers-list-results { border-top: 1px solid #b6c5d2; }
.pl-papers-list-row { border-bottom: 1px solid #cbd6de; padding: .8rem .15rem .75rem; }
.pl-papers-list-row h2 { font-size: 1.03rem; line-height: 1.32; margin: 0; }
.pl-papers-list-row h2 a { color: #17212b; }
.pl-papers-list-row h2 a:hover, .pl-papers-list-row h2 a:focus { color: #064d93; }
.pl-papers-list-meta { color: #586673; font-size: .8rem; margin: .32rem 0 .15rem; }
.pl-papers-list-group { background: #f5f8fa; border-bottom: 1px solid #b6c5d2; border-top: 1px solid #b6c5d2; color: #314353; font-size: .9rem; font-weight: bold; margin: -.8rem -.15rem .7rem; padding: .38rem .5rem; }
.pl-papers-list-empty { border: 1px solid #b6c5d2; padding: .9rem; }
@media (max-width: 700px) { .pl-papers-list-toolbar-grid { grid-template-columns: 1fr 1fr; } .pl-papers-list-toolbar-grid .pl-papers-list-search { grid-column: 1 / -1; } }
@media (max-width: 500px) { .pl-papers-list-header-row, .pl-papers-list-toolbar-grid { align-items: stretch; display: grid; grid-template-columns: 1fr; } .pl-papers-list-toolbar-grid .pl-papers-list-search { grid-column: auto; } .pl-papers-list-button, .pl-papers-list-create { box-sizing: border-box; text-align: center; width: 100%; } }
</style>

<div class="pl-papers-list">
  <div class="pl-papers-list-header">
    [% INCLUDE modernboxheader.tt title = 'Search Papers' %]
    <div class="pl-papers-list-header-row">
      [% IF total %]<p class="pl-papers-list-summary">Showing [% showing_from %]-[% showing_to %] of [% total %] matching paper[% IF total != 1 %]s[% END %].</p>[% ELSE %]<p class="pl-papers-list-summary">No papers match this view.</p>[% END %]
      <a class="pl-papers-list-create" href="/?op=addobj&amp;to=papers">Add Paper</a>
    </div>
  </div>

  <nav class="pl-papers-list-nav" aria-label="Papers navigation">
    <a href="/?op=browse&amp;from=papers">Papers</a>
    <a href="/?op=listobj&amp;from=papers" aria-current="page">Browse and search</a>
    <a href="/?op=listobj&amp;from=papers&amp;sort=created_desc">Latest additions</a>
  </nav>

  <form class="pl-papers-list-toolbar" method="get" action="/">
    <input type="hidden" name="op" value="listobj">
    <input type="hidden" name="from" value="papers">
    <div class="pl-papers-list-toolbar-grid">
      <div class="pl-papers-list-search"><label for="papers-list-search">Search titles, authors, or topics</label><input id="papers-list-search" type="search" name="q" value="[% search | html %]"></div>
      <div><label for="papers-list-sort">Sort by</label><select id="papers-list-sort" name="sort" onchange="this.form.submit()">[% FOREACH option IN sort_options %]<option value="[% option.value %]"[% IF sort == option.value %] selected[% END %]>[% option.label %]</option>[% END %]</select></div>
      <div><label for="papers-list-group">Group</label><select id="papers-list-group" name="group" onchange="this.form.submit()"><option value=""[% IF group == "" %] selected[% END %]>None</option><option value="letter"[% IF group == "letter" %] selected[% END %]>First letter</option></select></div>
      <div><button class="pl-papers-list-button" type="submit">Search</button></div>
    </div>
    [% IF active_filters %]<div class="pl-papers-list-tools"><a href="/?op=listobj&amp;from=papers">Clear filters</a></div>[% END %]
  </form>

  [% IF objects.size %]
    <nav class="pl-papers-list-pager" aria-label="Search result pages">[% pager %]</nav>
    <div class="pl-papers-list-results">
      [% last_group = "" %]
      [% FOREACH object IN objects %]
        <article class="pl-papers-list-row">
          [% IF group == "letter" AND object.group_label != last_group %]<div class="pl-papers-list-group">[% object.group_label %]</div>[% last_group = object.group_label %][% END %]
          <h2><a href="/?op=getobj&amp;from=papers&amp;id=[% object.id %]">[% object.title | html %]</a></h2>
          <div class="pl-papers-list-meta">[% IF object.authors %]Authors: [% object.authors | html %] | [% END %]Added by <a href="/?op=getuser&amp;id=[% object.userid %]">[% object.username | html %]</a> | Uploaded [% object.date %][% IF object.classification %] | Classification: [% object.classification %][% END %]</div>
        </article>
      [% END %]
    </div>
    <nav class="pl-papers-list-pager" aria-label="Search result pages">[% pager %]</nav>
  [% ELSE %]
    <p class="pl-papers-list-empty">No papers match these filters.</p>
  [% END %]
</div>
