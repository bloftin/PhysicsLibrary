<style type="text/css">
.pl-unproven { color: #1d2935; font-family: Arial, Helvetica, sans-serif; margin: 0 auto; max-width: 76rem; }
.pl-unproven a { color: #064d93; }
.pl-unproven-header { margin: 0 0 1rem; }
.pl-unproven-summary { color: #526170; font-size: .88rem; margin: .4rem 0 0; }
.pl-unproven-intro { background: #eef3f7; border: 1px solid #b6c5d2; color: #3e5265; font-size: .86rem; margin: 0 0 1rem; padding: .75rem; }
.pl-unproven-pager { border-bottom: 1px solid #b6c5d2; font-size: .9rem; margin: 0 0 .55rem; padding: 0 0 .45rem; text-align: center; }
.pl-unproven-list + .pl-unproven-pager { border-bottom: 0; border-top: 1px solid #b6c5d2; margin: .55rem 0 0; padding: .55rem 0 0; }
.pl-unproven-list { border-top: 1px solid #b6c5d2; }
.pl-unproven-row { border-bottom: 1px solid #cbd6de; padding: .8rem .15rem .75rem; }
.pl-unproven-row h2 { font-size: 1.03rem; line-height: 1.32; margin: 0; }
.pl-unproven-row h2 a { color: #17212b; }
.pl-unproven-row h2 a:hover, .pl-unproven-row h2 a:focus { color: #064d93; }
.pl-unproven-meta { color: #586673; font-size: .81rem; margin: .32rem 0 .42rem; }
.pl-unproven-actions { display: flex; flex-wrap: wrap; font-size: .84rem; gap: .35rem .75rem; }
.pl-unproven-proof { background: #174e80; border: 1px solid #103a61; color: #fff !important; font-weight: bold; padding: .28rem .52rem; text-decoration: none; }
.pl-unproven-proof:hover, .pl-unproven-proof:focus { background: #103a61; }
.pl-unproven-empty { border: 1px solid #b6c5d2; color: #526170; margin: 0; padding: .85rem; }
</style>

<div class="pl-unproven">
  <div class="pl-unproven-header">
    [% INCLUDE modernboxheader.tt title = 'Unproven Theorems' %]
    <p class="pl-unproven-summary">[% total %] theorem[% IF total != 1 %]s[% END %] awaiting a proof.</p>
  </div>

  <p class="pl-unproven-intro">These theorems have no attached proof. Review one and contribute a proof to strengthen the collection.</p>

  [% IF theorems.size %]
    <nav class="pl-unproven-pager" aria-label="Unproven theorem pages">[% pager %]</nav>
    <div class="pl-unproven-list">
      [% FOREACH theorem IN theorems %]
        <article class="pl-unproven-row">
          <h2><a href="[% theorem.object_url %]">[% theorem.title %]</a></h2>
          <div class="pl-unproven-meta">Unproven theorem [% theorem.ord %]</div>
          <div class="pl-unproven-actions"><a href="[% theorem.object_url %]">View theorem</a><a class="pl-unproven-proof" href="[% theorem.proof_url %]">Write proof</a></div>
        </article>
      [% END %]
    </div>
    <nav class="pl-unproven-pager" aria-label="Unproven theorem pages">[% pager %]</nav>
  [% ELSE %]
    <p class="pl-unproven-empty">Every theorem in the collection currently has a proof.</p>
  [% END %]
</div>
