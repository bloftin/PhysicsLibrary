<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    [% IF no_index %]<meta name="robots" content="noindex,follow" />[% END %]
    <style type="text/css">
.pl-home-masthead img { height: auto; max-width: 100%; }
.pl-home-masthead input[type=text] { box-sizing: border-box; max-width: 100%; }
.pl-home-mobile-links { display: none; }
.pl-home-layout { align-items: start; color: #1d2935; display: grid; font-family: Arial, Helvetica, sans-serif; gap: 12px; grid-template-columns: 155px minmax(0, 1fr) 270px; }
.pl-home-layout > * { min-width: 0; }
.pl-home-main, .pl-home-right { display: grid; align-content: start; gap: 1rem; }
.pl-home-widget { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.pl-home-title { background: #003399; border-bottom: 1px solid #002266; box-sizing: border-box; color: #fff; font-size: 1rem; line-height: 1.2; margin: 0 0 .55rem; padding: .15rem .5rem; }
.pl-home-widget a { color: #174e80; }
.pl-home-widget a:focus-visible, .pl-home-widget input:focus-visible, .pl-home-widget button:focus-visible { outline: 2px solid #003399; outline-offset: 2px; }
.pl-home-welcome p { font-size: .88rem; line-height: 1.55; margin: .6rem 0; }
.pl-home-browse { border-top: 1px solid #cbd6de; display: flex; flex-wrap: wrap; font-size: .86rem; gap: .5rem 1.2rem; padding-top: .65rem; }
.pl-home-browse a:first-child { font-weight: bold; }
.pl-home-subtitle { color: #526170; font-size: .75rem; font-weight: bold; margin: .6rem 0 .25rem; }
.pl-home-ranking, .pl-home-latest-list, .pl-home-messages { list-style: none; margin: 0; padding: 0; }
.pl-home-ranking li { border-bottom: 1px solid #e1e7ec; display: grid; font-size: .8rem; gap: .6rem; grid-template-columns: minmax(0, 1fr) auto; padding: .2rem 0; }
.pl-home-ranking span { color: #526170; font-variant-numeric: tabular-nums; }
.pl-home-latest-list li { border-bottom: 1px solid #e1e7ec; font-size: .8rem; line-height: 1.4; padding: .3rem 0; }
.pl-home-more { display: inline-block; font-size: .8rem; margin-top: .55rem; }
.pl-home-empty { color: #526170; font-size: .82rem; line-height: 1.45; margin: .55rem 0; }
.pl-home-messages li { border-bottom: 1px solid #cbd6de; padding: .6rem 0; }
.pl-home-message-heading { align-items: baseline; display: flex; flex-wrap: wrap; font-size: .88rem; gap: .3rem 1rem; }
.pl-home-message-heading a { flex: 1 1 15rem; font-weight: bold; }
.pl-home-message-heading span { color: #526170; font-size: .76rem; }
.pl-home-message-meta { align-items: baseline; color: #526170; display: flex; flex-wrap: wrap; font-size: .78rem; gap: .25rem .65rem; margin-top: .3rem; }
.pl-home-poll { font-size: .82rem; }
.pl-home-poll fieldset { border: 0; margin: 0; min-width: 0; padding: 0; }
.pl-home-poll legend { font-weight: bold; line-height: 1.4; margin-bottom: .5rem; padding: 0; }
.pl-home-poll label { align-items: start; display: grid; gap: .5rem; grid-template-columns: auto minmax(0, 1fr); line-height: 1.4; margin: .35rem 0; }
.pl-home-poll input[type=radio] { margin: .15rem 0 0; }
.pl-home-poll-actions { align-items: center; display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .65rem; }
.pl-home-poll button { background: #003399; border: 1px solid #002266; border-radius: 2px; color: #fff; cursor: pointer; font: inherit; padding: .3rem .65rem; }
@media (max-width: 1000px) { .pl-home-layout { grid-template-columns: 155px minmax(0, 1fr) 220px; } }
@media (max-width: 820px) {
  .pl-home-layout { grid-template-columns: 155px minmax(0, 1fr); }
  .pl-home-left { grid-column: 1; grid-row: 1 / span 2; }
  .pl-home-main, .pl-home-right { grid-column: 2; }
}
@media (max-width: 560px) {
  .pl-home-mobile-links { display: flex; font: .82rem Arial, Helvetica, sans-serif; gap: 1rem; padding: .5rem 0; }
  .pl-home-mobile-links a { color: #174e80; }
  .pl-home-masthead table { width: 100%; }
  .pl-home-masthead td { display: block; text-align: left; width: auto; }
  .pl-home-layout { grid-template-columns: minmax(0, 1fr); }
  .pl-home-main { grid-column: 1; grid-row: 1; }
  .pl-home-right { grid-column: 1; grid-row: 2; }
  .pl-home-left { grid-column: 1; grid-row: 3; }
}
    </style>
    [% head %]
  </head>
  <body>
    <div class="pl-home-masthead">[% header %]</div>
    <nav class="pl-home-mobile-links" aria-label="Page sections"><a href="#pl-home-navigation">Account &amp; menu</a><a href="#pl-home-recent">Recent activity</a></nav>
    <div class="pl-home-layout">
      <div class="pl-home-left" id="pl-home-navigation">[% sidebar %]</div>
      <main class="pl-home-main">
        [% IF search_results %]
        <section class="pl-home-widget" aria-label="Search results">
          <h1 class="pl-home-title">Search Results</h1>
          <div class="gcse-searchresults-only"></div>
        </section>
        [% ELSE %]
        <section class="pl-home-widget pl-home-welcome" aria-label="Welcome to Physics Library">
          <h1 class="pl-home-title">Welcome!</h1>
          <p>Physics Library is an open source physics library built by its community. Explore the <a href="/encyclopedia">physics encyclopedia</a>, with articles written and reviewed by members.</p>
          <p>Contributions are written in <a href="https://www.latex-project.org/">LaTeX</a> and shared under the <a href="https://creativecommons.org/licenses/by-sa/4.0/">Creative Commons Attribution-ShareAlike CC BY-SA 4.0 License</a>.</p>
          <p>Join the community through the <a href="/?op=forums">forums</a>, contribute to an <a href="/?op=reqlist">article request</a>, or <a href="/?op=newuser">create a free account</a>.</p>
          <nav class="pl-home-browse" aria-label="Browse the library">
            <a href="/encyclopedia">Encyclopedia</a>
            <a href="/?op=browse;from=papers">Papers</a>
            <a href="/?op=browse;from=books">Books</a>
            <a href="/?op=browse;from=lec">Lectures</a>
          </nav>
        </section>
        [% latestmessages %]
        [% END %]
      </main>
      <aside class="pl-home-right" id="pl-home-recent" aria-label="Community and recent entries">
        [% top_users %]
        [% poll %]
        [% latestadditions %]
        [% latestrevisions %]
      </aside>
    </div>
  </body>
</html>

