<!-- clear box -->
<table width="100%" cellpadding="0" cellspacing="0">
	<tr>
		<td>
			<table width="100%">
				<tr>
					<td bgcolor="#000000">

						<!-- title box -->
						
						<table WIDTH="100%" BORDER="0" CELLPADDING="1" CELLSPACING="0">
							<tr>
								<td WIDTH="100%" BGCOLOR="#003399">
									<font color="white" class="box_title">
										[% section %]
									</font>
								</td>
							</tr>
						</table>
					</td>
				</tr>
			</table>
		</td>
	</tr>
	
	<tr>
		<td>
			<!-- content box -->
			<table width="100%" cellpadding="0" cellspacing="2">
				<tr>
					<td>
	
                        [% IF section == "Papers" %]
                            Papers are research-calibre (though not necessarily published) lectures of some topic. You can browse papers
                        [% ELSIF section == "Lectures" %]
                            Lectures are lectures, lecture notes, or written lessons which have as their focus education rather than research. You can browse lectures
                        [% ELSIF section == "Books" %]
                            This section is for books which are available for free in electronic form. You can browse books
                        [% END %]

                        <!-- list of browse methods -->
                        <ul>
							<li>
								<a href=/?op=listobj&amp;from=[% table %]> Chronologically</a>
							</li>
							[% IF class %]
                                <li>
                                    <a href=/?op=pacsbrowse&amp;from=[% table %]> Physics Subject Classification</a>

                                </li>
                            [% END %]
						</ul>
					</td>
				</tr>

                <tr>
			        <td>
                        <!-- standard box -->
                        <table width="100%">
                            <tr>
                                <td bgcolor="#000000">
                                    <table WIDTH="100%" BORDER="0" CELLPADDING="1" CELLSPACING="0">

                                        <!-- title -->
                                        <tr>
                                            <td WIDTH="100%" BGCOLOR="#003399">
                                                <font color="white" class="box_title">
                                                    [% section %]
                                                </font>
                                            </td>
                                        </tr>
                                    
                                        <!-- content -->
                                        <tr>
                                            <td WIDTH="100%" BGCOLOR="dddddd">
                                                <center>
                                                    <a href=/?op=addobj&amp;to=[% table %]> Add to [% section %] </a>
                                                </center>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                        <!-- end standard box -->
			        </td>
		        </tr>

			</table>
		</td>
	</tr>
</table>
<!-- end clear box -->


