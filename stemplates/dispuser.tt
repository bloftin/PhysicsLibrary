[% INCLUDE settingsstyles.tt %]
<div class="pl-settings">
  [% profile_title = 'User Info for ' _ user.username %]
  [% INCLUDE modernboxheader.tt title = profile_title %]
  <div class="pl-settings-body">
    [% IF user.active == 1 %]
    <dl>
      <div class="pl-settings-detail"><dt>User ID:</dt><dd>[% user.username | html %]</dd></div>
      [% IF user.forename || user.surname %]<div class="pl-settings-detail"><dt>Name:</dt><dd>[% user.forename | html %] [% user.surname | html %]</dd></div>[% END %]
      [% IF loggedin == 1 %]
      <div class="pl-settings-detail"><dt>E-mail Address:</dt><dd>[% IF show_email %][% user.email | html %][% ELSE %]Email hidden by user preferences.[% END %]</dd></div>
      [% END %]
      [% IF user.state.trim or user.city.trim or user.country.trim %]
      <div class="pl-settings-detail"><dt>From:</dt><dd>[% user.city | html %], [% IF user.state %][% user.state | html %], [% END %][% user.country | html %]</dd></div>
      [% END %]
      <div class="pl-settings-detail"><dt>Joined On:</dt><dd>[% user.joined | html %]</dd></div>
      <div class="pl-settings-detail"><dt>Last Logged in:</dt><dd>[% user.last | html %]</dd></div>
      [% IF user.homepage.trim %]
      <div class="pl-settings-detail"><dt>Homepage:</dt><dd>
        [% IF user.homepage.search('(?i)^https?://') %]
        <a href="[% user.homepage | html %]">[% user.homepage | html %]</a>
        [% ELSE %][% user.homepage | html %]<p class="pl-settings-note">Note: if you want a hyperlink to site add http:// or https://</p>[% END %]
      </dd></div>
      [% END %]
      <div class="pl-settings-detail"><dt>Access Level:</dt><dd>[% user.access | html %]</dd></div>
      <div class="pl-settings-detail"><dt>Score:</dt><dd>[% user.score | html %] [% IF isadmin %]<a href="/?op=editscore&amp;user=[% userID | html %]">(admin edit)</a>[% END %]</dd></div>
    </dl>
    <h2>[% user.username | html %]'s</h2>
    <ul class="pl-settings-list">
      <li><a href="[% msg_link | html %]">Message Count ([% mc | html %])</a></li>
      <li><a href="[% obj_link | html %]">Object Count ([% oc | html %])</a></li>
      <li><a href="[% cfc_link | html %]">Corrections Filed ([% cfc | html %])</a></li>
      <li><a href="[% crc_link | html %]">Corrections Received ([% crc | html %])</a></li>
    </ul>
    [% IF user.bio.trim %]<h2>Bio:</h2><div class="pl-settings-rich">[% user.bio %]</div>[% END %]
    [% ELSE %]<p class="pl-settings-error">(This account has been deactivated)</p>[% END %]
  </div>
</div>
