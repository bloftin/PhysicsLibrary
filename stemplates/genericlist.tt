<!-- a listing of generic objects (papers, lectures, books) -->

<!-- template that handles the "entire" screen for viewing a generic list -->

<!-- clear box -->
<table width="100%" cellpadding="0" cellspacing="0">
	<tr>
		<td>
			<table width="100%">
				<tr>
					<td bgcolor="#000000">

						<!-- title box -->
						
						<table WIDTH="100%" BORDER="0" CELLPADDING="1" CELLSPACING="0">
							<tr>
								<td WIDTH="100%" BGCOLOR="#003399">
									<font color="white" class="box_title">
										Browse and search [% name | html %]
									</font>
								</td>
							</tr>
						</table>
					</td>
				</tr>
			</table>
		</td>
	</tr>
	
	<tr>
		<td>
			<!-- content box -->
			<table width="100%" cellpadding="0" cellspacing="2">
				<tr>
					<td>
	
                        <form method="get" action="/">
                            <input type="hidden" name="op" value="listobj">
                            <input type="hidden" name="from" value="[% table %]">

                            <label for="list-search">[% IF encyclopedia %]Search encyclopedia:[% ELSE %]Search title/author:[% END %]</label>
                            <input id="list-search" type="search" name="q" value="[% search | html %]" size="24">
                            <input type="submit" value="search">

                            Sort:
                            <select name="sort" onchange="this.form.submit()">
                                [% FOREACH option IN sort_options %]
                                    <option value="[% option.value %]"[% IF sort == option.value %] selected[% END %]>[% option.label %]</option>
                                [% END %]
                            </select>

                            Group:
                            <select name="group" onchange="this.form.submit()">
                                <option value=""[% IF group == "" %] selected[% END %]>none</option>
                                <option value="letter"[% IF group == "letter" %] selected[% END %]>first letter</option>
                            </select>

                            [% IF active_filters %]
                                <a href="/?op=listobj&amp;from=[% table %]">clear</a>
                            [% END %]
                        </form>
                        [% IF encyclopedia %]
                        <p><a href="/encyclopedia">Alphabetical index</a> | <a href="/browse/objects/">Browse by subject</a></p>
                        [% END %]

                        [% pager %]

                        [% IF objects.size %]
                        <table width="100%" cellpadding="2" cellspacing="0">

                            [% last_group = "" %]
                            [% FOREACH object IN objects %]

                                [% IF group == "letter" AND object.group_label != last_group %]
                                    <tr>
                                        <td colspan="3" bgcolor="#dddddd">
                                            <b>[% object.group_label %]</b>
                                        </td>
                                    </tr>
                                    [% last_group = object.group_label %]
                                [% END %]

                                <tr>

                                    <!-- record index -->
                                    <td valign="top">
                                        [% object.ord %].			
                                    </td>

                                    <!-- title and uploader -->
                                    <td>

                                        <a href=/?op=getobj;from=[% table %];id=[% object.id %]>[% object.title | html %]</a>

                                        [% IF encyclopedia %]owned by[% ELSE %]added by[% END %]

                                        <a href=/?op=getuser;id=[% object.userid %]> [% object.username | html %]</a>

                                    </td>

                                </tr>

                                <tr>

                                    <td>&nbsp;</td>

                                    <!-- the rest of the metadata -->

                                    <td> 
                                        
                                        [% IF encyclopedia %]Type: [% object.article_type | html %][% ELSE %]Authors: [% object.authors | html %][% END %]

                                        <p></p>

                                        [% IF encyclopedia %]Added on:[% ELSE %]Uploaded on:[% END %] [% object.date %]

                                        [%IF object.classification %]
                                        , Classification: [% object.classification %]
                                        [% END %]
                                    
                                    </td>

                                </tr>

                            [% END %]

                        </table>
                        [% ELSE %]
                            <p>Nothing to show.</p>
                        [% END %]

                        [% pager %]



					</td>
				</tr>

                <tr>
                    <td>


                        <!-- standard box -->
                        <table width="100%">
                            <tr>
                                <td bgcolor="#000000">
                                    <table WIDTH="100%" BORDER="0" CELLPADDING="1" CELLSPACING="0">

                                        <!-- title -->
                                        <tr>
                                            <td WIDTH="100%" BGCOLOR="#003399">
                                                <font color="white" class="box_title">
                                                    Interact
                                                </font>
                                            </td>
                                        </tr>
                                    
                                        <!-- content -->
                                        <tr>
                                            <td WIDTH="100%" BGCOLOR="dddddd">
                                                <center>
                                                    [% IF encyclopedia %]<a href="/?op=adden">Add article</a>[% ELSE %]<a href=/?op=addobj;to=[% table %]> Add to  [% name %]</a>[% END %]
                                                </center>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                        <!-- end standard box -->

                    </td>
                </tr>
			</table>
		</td>
	</tr>
</table>
<!-- end clear box -->
