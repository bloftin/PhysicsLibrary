<style type="text/css">
.pl-snapshots { color: #1d2935; font-family: Arial, Helvetica, sans-serif; margin: 0 auto; max-width: 76rem; overflow-wrap: anywhere; }
.pl-snapshots a { color: #064d93; }
.pl-snapshots a:focus-visible { outline: 2px solid #003399; outline-offset: 2px; }
.pl-snapshots-intro { font-size: .9rem; line-height: 1.5; margin: .65rem 0 1rem; }
.pl-snapshots-count { color: #445b70; font-size: .85rem; margin: 0 0 .5rem; }
.pl-snapshots-list { list-style: none; margin: 0; padding: 0; }
.pl-snapshot { align-items: center; border-top: 1px solid #cbd6de; display: grid; gap: .4rem 1rem; grid-template-columns: minmax(0, 1fr) auto; padding: .8rem 0; }
.pl-snapshot:last-child { border-bottom: 1px solid #cbd6de; }
.pl-snapshot-name { font-size: .95rem; font-weight: bold; line-height: 1.4; margin: 0 0 .3rem; }
.pl-snapshot-meta { color: #445b70; display: flex; flex-wrap: wrap; font-size: .85rem; gap: .3rem 1rem; line-height: 1.5; margin: 0; }
.pl-snapshots .pl-snapshot-download { background: #194f78; border: 1px solid #153f60; color: #fff; font-size: .85rem; padding: .4rem .65rem; text-decoration: none; white-space: nowrap; }
.pl-snapshots .pl-snapshot-download:hover { background: #123e60; }
.pl-snapshots-empty { border-top: 1px solid #cbd6de; font-size: .9rem; line-height: 1.5; margin: .5rem 0; padding: .8rem 0; }
@media (max-width: 640px) {
  .pl-snapshot { grid-template-columns: minmax(0, 1fr); }
  .pl-snapshot-download { justify-self: start; }
}
</style>

<div class="pl-snapshots">
  [% INCLUDE modernboxheader.tt title = 'Snapshots' %]
  <p class="pl-snapshots-intro">Download archived snapshots of the library.[% UNLESS signed_in %] Sign in to download an archive.[% END %]</p>
  [% IF available %]
    [% IF archives.size %]
      <p class="pl-snapshots-count">[% archives.size %] archive[% IF archives.size != 1 %]s[% END %] available</p>
      <ul class="pl-snapshots-list" aria-label="Snapshot archives">
        [% FOREACH archive IN archives %]
          <li class="pl-snapshot">
            <div>
              <p class="pl-snapshot-name"><a href="[% archive.url | html %]">[% archive.name | html %]</a></p>
              <p class="pl-snapshot-meta">
                <span>Last modified <time datetime="[% archive.modified_iso | html %]">[% archive.modified | html %]</time></span>
                <span>[% archive.size | html %]</span>
                <span>[% archive.format | html %]</span>
              </p>
            </div>
            <a class="pl-snapshot-download" href="[% archive.url | html %]" aria-label="Download [% archive.name | html %]">Download</a>
          </li>
        [% END %]
      </ul>
    [% ELSE %]
      <p class="pl-snapshots-empty">No snapshot archives are available yet.</p>
    [% END %]
  [% ELSE %]
    <p class="pl-snapshots-empty">Snapshot archives are temporarily unavailable. Please try again later.</p>
  [% END %]
</div>
