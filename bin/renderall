#!/usr/bin/perl

###############################################################################
#
# The background rendering script.  This exists to make sure the system is 
# productive even during "idle" time (client-wise), and helps minimize the 
# number of rendering waits the user is subject to.
#
###############################################################################

use DBI;
use Fcntl qw(:flock);
use File::Path qw(make_path);
use FindBin;
use lib "$FindBin::Bin/../lib";

use Noosphere qw($dbh $DEBUG);
use Noosphere::DB;
use Noosphere::Cache;
use Noosphere::Config;
use Noosphere::Cache;
use Noosphere::Util;

my $nsroot = "$FindBin::Bin/..";

# Keep png/page-image rendering out of cron for now. The png pipeline can run
# heavyweight LaTeX/Ghostscript jobs and has recently pegged the web server.
my @methods = ('l2h','src');
my $table = Noosphere::getConfig('en_tbl');
my $rundir = "$nsroot/bin/run";
my $runfile = "$rundir/renderall.running";
my $logdir = "$nsroot/log";
my $remove_runfile = 0;
my $max_total = $ENV{'RENDERALL_MAX_TOTAL'} || 2;
my $max_per_method = $ENV{'RENDERALL_MAX_PER_METHOD'} || 1;
my $max_skips_per_method = $ENV{'RENDERALL_MAX_SKIPS_PER_METHOD'} || 25;
my $stale_lock_seconds = $ENV{'RENDERALL_STALE_LOCK_SECONDS'} || 3600;

$|=1;

require_apache_user();
make_path($rundir) unless -d $rundir;
make_path($logdir) unless -d $logdir;
open(my $lockfh, '+>>', $runfile) or die "could not open $runfile: $!";
if (!flock($lockfh, LOCK_EX | LOCK_NB)) {
	exit 1;
}
seek($lockfh, 0, 0);
truncate($lockfh, 0);
print $lockfh "$$\n";
$remove_runfile = 1;
END {
	unlink $runfile if $remove_runfile && defined $runfile;
}
$SIG{'INT'} = $SIG{'TERM'} = sub {
	unlink $runfile if $remove_runfile && defined $runfile;
	exit 124;
};

$DEBUG = 2;	 # dont need debugging of database access

open STDERR, ">", "$logdir/error-renderall";

# connect to the database
#
$dbh = Noosphere::dbConnect;

print "removing dead objects\n";

# remove dead objects
#
my ($rv,$sth) = Noosphere::dbLowLevelSelect($dbh,"select distinct cache.objectid from cache left outer join objects on cache.objectid = objects.uid where cache.tbl='$table' and objects.uid is null");
while (my $row = $sth->fetchrow_hashref()) {
	print "dangling cacheref ($row->{objectid}), deleting\n";
	Noosphere::deletecacheflags($table,$row->{objectid});
	
}
$sth->finish();

print "checking for invalid objects and rendering\n";

my $rendered_total = 0;
foreach my $method (@methods) {
	my $rendered = 0;
	my $skipped = 0;
	my %skip_objectid;
	while ($rendered < $max_per_method && $rendered_total < $max_total && $skipped < $max_skips_per_method && (my $row = getNextRow($method, \%skip_objectid))) {
		if (!prepareRenderLock($table, $row->{'objectid'}, $method)) {
			print "skipping $row->{title} ($row->{objectid}) [$method]; render lock is active or unavailable\n";
			$skip_objectid{$row->{'objectid'}} = 1;
			$skipped++;
			next;
		}

		$rendered++;
		$rendered_total++;
	
		# message, and fix timed out build
		#
		if ($row->{'build'}==1) {
			print "timed out $row->{title} ($row->{objectid}), rerendering ";
			Noosphere::setbuildflag_off($table,$row->{'objectid'},$method);
		} else {
			print "rendering $row->{title} ($row->{objectid}) ";
		}

		# get the full row record
		#
		my ($rv,$sth) = Noosphere::dbSelect($dbh,{WHAT=>"*",FROM=>$table,WHERE=>"uid=$row->{objectid}"});
		my $rec = $sth->fetchrow_hashref();
		$sth->finish();

		print "got rec $rec->{title} $rec->{uid}\n";
		my ($valid,$build)=Noosphere::getcacheflags($table,$rec->{uid},$method);
		print "cache flags build=$build, valid=$valid\n";

		# render the object to cache
		#
		print "[$method]";
	
		open(OLDOUT, ">&STDOUT");
		open STDOUT, ">>$logdir/stdout-renderall";
		print "\ncacheObject: table:\n $table";	
		print "rec: $rec->{title} ($rec->{uid})\n";
		Noosphere::cacheObject($table, $rec, $method);
		open(STDOUT, ">&OLDOUT");

		print "\n";
	}
	print "rendered $rendered $method objects";
	print ", skipped $skipped locked objects" if ($skipped);
	print "\n";

}
print "rendered $rendered_total total objects\n";

close STDERR;

unlink $runfile;
$remove_runfile = 0;

###############################################################################

sub getNextRow {
	my $method = shift;
	my $skip_objectid = shift || {};

	my $table = Noosphere::getConfig('en_tbl');
	
	my $int;
	$int = "interval '10 minutes'" if Noosphere::getConfig('dbms') eq 'pg';
	$int = "interval 10 MINUTE" if Noosphere::getConfig('dbms') eq 'mysql';
	$int = "interval 10 MINUTE" if Noosphere::getConfig('dbms') eq 'MariaDB';

	my $skip = '';
	if (%$skip_objectid) {
		my @ids = grep { /^\d+$/ } keys %$skip_objectid;
		$skip = " and cache.objectid not in (".join(',', @ids).")" if (@ids);
	}
	
	my ($rv,$sth) = Noosphere::dbSelect($dbh,{
		 WHAT => "cache.objectid,cache.build,cache.touched,$table.title",
		 FROM => "cache,$table",
		 WHERE => "cache.valid=0 and (cache.build=0 or cache.touched <= now() - $int) and $table.uid=cache.objectid and method='$method'$skip",
		 LIMIT => 1});

	return undef if ($sth->rows()<1);
	
	my $row = $sth->fetchrow_hashref();
	$sth->finish();

	return $row;
}

sub require_apache_user {
	return if ($ENV{'RENDERALL_ALLOW_ANY_USER'});

	my $user = getpwuid($>) || '';
	return if ($user eq 'apache');

	die "renderall must run as apache; use: sudo -u apache $0\n";
}

sub prepareRenderLock {
	my $table = shift;
	my $id = shift;
	my $method = shift;

	my $lockfile = Noosphere::getConfig('cache_root')."/$table/$id/$method/render.lock";
	return 1 if (!-e $lockfile);

	if (open(my $fh, '+>>', $lockfile)) {
		if (flock($fh, LOCK_EX | LOCK_NB)) {
			close($fh);
			return 1;
		}

		my $age = time - (stat($lockfile))[9];
		close($fh);
		if ($age > $stale_lock_seconds) {
			print "removing stale render lock $lockfile age=${age}s\n";
			unlink $lockfile or do {
				print "could not remove stale render lock $lockfile: $!\n";
				return 0;
			};
			return 1;
		}

		print "render lock active for $lockfile age=${age}s\n";
		return 0;
	}

	print "could not open render lock $lockfile: $!\n";
	return 0;
}

