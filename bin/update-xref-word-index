#!/usr/bin/perl

use strict;
use warnings;
use FindBin;
use Getopt::Long qw(GetOptions);
use lib "$FindBin::Bin/../lib";

use Noosphere;
use Noosphere::DB;
use Noosphere::Indexing;

my ($apply, $limit, $objectid);
$limit = 1;
GetOptions(
	'apply' => \$apply,
	'limit=i' => \$limit,
	'object=i' => \$objectid,
) or die "usage: $0 [--apply] [--limit N] [--object ID]\n";

die "--limit must be positive\n" if (!defined($limit) || $limit < 1);

$Noosphere::dbh = Noosphere::dbConnect();
my $table = Noosphere::getConfig('en_tbl');

my @where = ("not exists (select 1 from wordidx_state wis where wis.tbl = ? and wis.objectid = o.uid)");
my @bind = ($table);
if (defined($objectid)) {
	push @where, 'o.uid = ?';
	push @bind, $objectid;
}

my $sql = "select o.uid, o.data from $table o where " . join(' and ', @where) . ' order by o.uid limit ?';
push @bind, $limit;
my $sth = $Noosphere::dbh->prepare($sql) or die "could not prepare word-index scan\n";
$sth->execute(@bind) or die "could not scan for unindexed articles\n";

my @entries;
while (my $entry = $sth->fetchrow_hashref()) {
	push @entries, $entry;
}
$sth->finish();

if (!$apply) {
	print scalar(@entries) . " unindexed article(s) selected; rerun with --apply to index them.\n";
	$Noosphere::dbh->disconnect();
	exit 0;
}

my $indexed = 0;
my $failed = 0;
foreach my $entry (@entries) {
	my $ok = eval {
		$Noosphere::dbh->begin_work();
		Noosphere::wordIndexEntry($table, $entry);
		# A title added before this source was indexed could not invalidate
		# its renders. Backfilling the index must also refresh those links.
		my $cache = Noosphere::getConfig('cache_tbl');
		my $rv = $Noosphere::dbh->do(
			"update $cache set valid=0, touched=CURRENT_TIMESTAMP where tbl=? and objectid=?",
			undef, $table, $entry->{uid},
		);
		die "could not invalidate cached article $entry->{uid}\n" unless defined $rv;
		Noosphere::markWordIndexCurrent($entry->{uid}, $table);
		$Noosphere::dbh->commit();
		1;
	};
	if (!$ok) {
		my $error = $@ || 'unknown error';
		eval { $Noosphere::dbh->rollback(); };
		warn "could not index article $entry->{uid}: $error";
		$failed++;
		next;
	}
	$indexed++;
	print "indexed article $entry->{uid}\n";
}

print "indexed $indexed article(s)\n";
$Noosphere::dbh->disconnect();
exit($failed ? 1 : 0);
