#!/bin/bash

# this script cleans out the temp directory.  it removes all directories that
# are older than 1 day.
#

CACHEDIR="$(cd "$(dirname "$0")/.." && pwd)/data/cache/temp"

if [ ! -d "$CACHEDIR" ]; then
	exit 0
fi

# the `find' command basically does all the work for us.
#
find "$CACHEDIR" -mindepth 1 -maxdepth 1 -type d -mtime +1 -exec rm -rf -- '{}' '+' 2>/dev/null >/dev/null
