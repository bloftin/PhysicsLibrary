#!/usr/bin/perl

# this script deletes 

use DBI;
use FindBin;
use lib "$FindBin::Bin/../lib";

use Noosphere qw($dbh $DEBUG);
use Noosphere::Config;
use Noosphere::DB;

$dbh = Noosphere::dbConnect;

my $table = Noosphere::getConfig('results_tbl');
my $keep = Noosphere::getConfig('keep_search_results');

my $dbms = Noosphere::getConfig('dbms');

my ($rv,$sth);
($rv,$sth) = Noosphere::dbDelete($dbh,{FROM=>$table,WHERE=>"now()-ts > interval '$keep'"}) if $dbms eq 'pg';
($rv,$sth) = Noosphere::dbDelete($dbh,{FROM=>$table,WHERE=>"ts + interval $keep < now()"}) if $dbms eq 'mysql';
($rv,$sth) = Noosphere::dbDelete($dbh,{FROM=>$table,WHERE=>"ts + interval $keep < now()"}) if $dbms eq 'MariaDB';

$sth->finish() if $sth;

